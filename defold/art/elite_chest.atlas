  images { image: "/art/elite_chest/elite_chest_01.png" }
  images { image: "/art/elite_chest/elite_chest_02.png" }
  images { image: "/art/elite_chest/elite_chest_03.png" }
  images { image: "/art/elite_chest/elite_chest_04.png" }
  images { image: "/art/elite_chest/elite_chest_05.png" }
