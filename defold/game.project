[project]
title = Latunnaya Noch
version = 0.2.0

[bootstrap]
main_collection = /game/main.collectionc

[display]
width = 432
height = 768
high_dpi = 1
dynamic_orientation = 0
vsync = 1

[input]
game_binding = /input/game.input_bindingc

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[gui]
max_count = 2

[android]
package = com.andniko.latunnayanoch.defold
